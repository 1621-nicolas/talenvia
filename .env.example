# Copia como .env (el archivo .env está ignorado en Git).
# Talenvía: SQL Server local + Django. NO publiques contraseñas.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_SECRET_KEY=clave-unica-de-desarrollo

# Motor principal: sqlserver. Para exportar o depurar SQLite: sqlite.
DB_ENGINE=sqlserver
DB_NAME=TalenviaDB
DB_HOST=localhost
DB_PORT=
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# windows: inicia con tu usuario Windows (si tienes permisos en SQL Server).
# sqlserver: nombre de usuario SQL + contraseña local no versionada.
DB_AUTH=windows
# DB_USER=talenvia_app
# DB_PASSWORD=TU_CONTRASENA_LOCAL

# Solo desarrollo local con certificado autofirmado; nunca para producción.
DB_TRUST_SERVER_CERTIFICATE=true
